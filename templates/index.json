    "glunni_process": {
      "type": "multicolumn",
      "settings": {
        "title": "O Jeito Natural de Recuperar o Equilíbrio",
        "heading_size": "h1",
        "image_width": "third",
        "image_ratio": "square",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "primary",
