        "columns_mobile": "1",
        "padding_top": 52,
        "padding_bottom": 52
      },
      "blocks": {
        "step1": {
          "type": "column",
          "settings": {
            "title": "Passo 1 — O que está acontecendo",
            "text": "<p>O GLP-1 desacelera o esvaziamento do estômago e reduz a produção de ácido e enzimas — por isso vêm a náusea, o inchaço e a prisão de ventre.</p>"
          }
        },
        "step2": {
          "type": "column",
          "settings": {
            "title": "Passo 2 — O que o Glunni ACV faz",
            "text": "<p>Vinagre de maçã, fibra prebiótica e enzimas digestivas trabalham juntos para apoiar a digestão e devolver o conforto após as refeições.</p>"
          }
        },
        "step3": {
          "type": "column",
          "settings": {
            "title": "Passo 3 — O que muda no seu corpo",
            "text": "<p>Em poucas semanas, a maioria sente menos inchaço, digestão mais leve e o intestino funcionando com mais regularidade.</p>"
          }
        }
      },
      "block_order": [
        "step1",
        "step2",
        "step3"
      ]
    },
