        "glunni_buybox": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<p class=\"glunni-sale-divider\"><span>Sale Ends Midnight</span></p>\n\n<div class=\"glunni-purchase-options\" data-glunni-purchase-options>\n  <label class=\"glunni-option\" data-glunni-option data-qty=\"1\" data-paid=\"1\" data-free=\"0\" data-label=\"Buy One\" data-sale=\"3999\" data-was=\"7998\" data-sub=\"2999\">\n    <input type=\"radio\" name=\"glunni-bundle\" value=\"1\">\n    <span class=\"glunni-option__radio\"></span>\n    <span class=\"glunni-option__body\">\n      <span class=\"glunni-option__label\">Buy One</span>\n    </span>\n    <span class=\"glunni-option__price\" data-price></span>\n  </label>\n\n  <label class=\"glunni-option glunni-option--featured\" data-glunni-option data-qty=\"3\" data-paid=\"2\" data-free=\"1\" data-label=\"Buy 2, Get 1 FREE\" data-sale=\"7998\" data-was=\"11997\" data-sub=\"5998\">\n    <input type=\"radio\" name=\"glunni-bundle\" value=\"3\" checked>\n    <span class=\"glunni-option__radio\"></span>\n    <span class=\"glunni-option__badge\">Most Popular</span>\n    <span class=\"glunni-option__body\">\n      <span class=\"glunni-option__label-row\">\n        <span class=\"glunni-option__label\">Buy 2, Get 1 FREE</span>\n        <span class=\"glunni-option__tag\">+ FREE Shipping</span>\n      </span>\n      <em>You Save 67%</em>\n    </span>\n    <span class=\"glunni-option__price\" data-price></span>\n  </label>\n\n  <label class=\"glunni-option\" data-glunni-option data-qty=\"5\" data-paid=\"3\" data-free=\"2\" data-label=\"Buy 3, Get 2 FREE\" data-sale=\"11997\" data-was=\"19995\" data-sub=\"8997\">\n    <input type=\"radio\" name=\"glunni-bundle\" value=\"5\">\n    <span class=\"glunni-option__radio\"></span>\n    <span class=\"glunni-option__badge glunni-option__badge--alt\">Best Value</span>\n    <span class=\"glunni-option__body\">\n      <span class=\"glunni-option__label-row\">\n        <span class=\"glunni-option__label\">Buy 3, Get 2 FREE</span>\n        <span class=\"glunni-option__tag\">+ FREE Shipping</span>\n      </span>\n      <em>You Save 70%</em>\n    </span>\n    <span class=\"glunni-option__price\" data-price></span>\n  </label>\n\n  <label class=\"glunni-subscribe-box\" data-glunni-subscribe>\n    <input type=\"checkbox\" data-glunni-subscribe-input>\n    <span class=\"glunni-subscribe-box__check\">\n      <svg viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6.2 12.1 2.4 8.3l1.2-1.2 2.6 2.6 5.6-5.6 1.2 1.2z\"/></svg>\n    </span>\n    <span class=\"glunni-subscribe-box__text\">\n      <span class=\"glunni-subscribe-box__title\">Save 25% with Automatic Refills</span>\n      <span class=\"glunni-subscribe-box__desc\">Zero commitment, Cancel Anytime</span>\n    </span>\n  </label>\n</div>\n\n<div class=\"glunni-trust-row\">\n  <span>Mastercard</span><span>Amex</span><span>Apple&nbsp;Pay</span><span>GPay</span><span>Shop</span><span>Discover</span><span>Visa</span>\n</div>\n<p class=\"glunni-guarantee\">60-Day Guarantee &middot; Free Shipping Over $50</p>\n\n<style>\n.glunni-purchase-options{border:1px solid rgba(0,0,0,.1);border-radius:10px;padding:1rem;margin:.9rem 0;}\n.glunni-option{display:flex;align-items:center;gap:.7rem;border:1px solid rgba(0,0,0,.12);border-radius:8px;padding:.7rem .9rem;margin-bottom:.5rem;cursor:pointer;position:relative;}\n.glunni-option input{position:absolute;opacity:0;}\n.glunni-option__radio{width:18px;height:18px;border-radius:50%;border:2px solid rgba(0,0,0,.3);flex:none;}\n.glunni-option:has(input:checked){border-color:#1f3d2b;background:#f2f6f2;}\n.glunni-option:has(input:checked) .glunni-option__radio{border-color:#1f3d2b;background:radial-gradient(circle,#1f3d2b 40%,transparent 44%);}\n.glunni-option__body{flex:1;display:flex;flex-direction:column;min-width:0;}\n.glunni-option__label-row{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;}\n.glunni-option__label{font-weight:600;}\n.glunni-option__tag{background:#eef3ee;color:#2f4a3a;font-size:.9rem;font-weight:600;padding:1px 7px;border-radius:20px;white-space:nowrap;}\n.glunni-option__body em{display:block;font-style:normal;font-weight:400;font-size:.9rem;opacity:.6;margin-top:.1rem;}\n.glunni-option__price{font-weight:700;text-align:right;white-space:nowrap;}\n.glunni-option__price .glunni-option__old-price{display:block;font-weight:400;opacity:.5;font-size:.9rem;text-decoration:line-through;}\n.glunni-option__price strong{font-size:1.15rem;}\n.glunni-option__badge{position:absolute;top:-10px;right:12px;background:#1f3d2b;color:#fff;font-size:.9rem;font-weight:600;padding:2px 8px;border-radius:4px;}\n.glunni-option__badge--alt{background:#8a6d3b;}\n\n.glunni-subscribe-box{display:flex;align-items:flex-start;gap:.8rem;border:2px dashed rgba(0,0,0,.25);border-radius:10px;background:#fff;padding:.75rem 1rem;margin-top:.6rem;cursor:pointer;position:relative;transition:all .15s ease;}\n.glunni-subscribe-box input{position:absolute;opacity:0;}\n.glunni-subscribe-box:has(input:checked){border:2px solid #1f3d2b;background:#f2f6f2;}\n.glunni-subscribe-box__check{width:22px;height:22px;border-radius:6px;border:2px solid rgba(0,0,0,.3);background:#fff;flex:none;margin-top:.1rem;display:flex;align-items:center;justify-content:center;}\n.glunni-subscribe-box__check svg{width:13px;height:13px;fill:#fff;opacity:0;transition:opacity .1s ease;}\n.glunni-subscribe-box:has(input:checked) .glunni-subscribe-box__check{background:#1f3d2b;border-color:#1f3d2b;}\n.glunni-subscribe-box:has(input:checked) .glunni-subscribe-box__check svg{opacity:1;}\n.glunni-subscribe-box__text{display:flex;flex-direction:column;gap:.1rem;}\n.glunni-subscribe-box__title{font-weight:700;font-size:1.1rem;}\n.glunni-subscribe-box__desc{font-size:.95rem;opacity:.65;line-height:1.25;}\n\n.glunni-trust-row{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin:.7rem 0 .25rem;font-size:.95rem;opacity:.6;}\n.glunni-guarantee{text-align:center;font-size:.95rem;opacity:.65;margin:0 0 .5rem;}\n\n.glunni-sale-divider{display:flex;align-items:center;text-align:center;gap:.75rem;font-size:.8rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.6;margin:1rem 0;}\n.glunni-sale-divider::before,.glunni-sale-divider::after{content:\"\";flex:1;height:1px;background:rgba(0,0,0,.15);}\n\n.product-form__submit{background:#1f3d2b !important;border-color:#1f3d2b !important;border-radius:10px !important;font-weight:700 !important;font-size:1.1rem !important;padding:.95rem !important;text-transform:none !important;}\n.product-form__submit:hover{background:#16301f !important;}\n.product-form__buttons .shopify-payment-button{display:none !important;}\n</style>\n\n{%- liquid\n  assign glunni_free_variant_id = null\n  for v in product.variants\n    if v.title == \"Free Gift (Included in Bundle)\"\n      assign glunni_free_variant_id = v.id\n    endif\n  endfor\n-%}\n<script>\n(function(){\n  var root = document.currentScript.closest('.shopify-section');\n  if (!root) return;\n  var freeVariantId = {{ glunni_free_variant_id | json }};\n  var options = Array.prototype.slice.call(root.querySelectorAll('[data-glunni-option]'));\n  var subscribeInput = root.querySelector('[data-glunni-subscribe-input]');\n\n  function getQtyInput(){\n    return document.querySelector('input[name=\"quantity\"], quantity-input input');\n  }\n\n  function fmt(cents){\n    return '$' + (cents / 100).toFixed(2);\n  }\n\n  function updatePrices(){\n    var subscribed = !!(subscribeInput && subscribeInput.checked);\n    options.forEach(function(opt){\n      var sale = parseInt(opt.dataset.sale, 10);\n      var was = parseInt(opt.dataset.was, 10);\n      var sub = parseInt(opt.dataset.sub, 10);\n      var now = subscribed ? sub : sale;\n      var priceEl = opt.querySelector('[data-price]');\n      if (!priceEl) return;\n      priceEl.innerHTML = '<span class=\"glunni-option__old-price\">' + fmt(was) + '</span><strong>' + fmt(now) + '</strong>';\n    });\n  }\n\n  function selectOption(opt){\n    options.forEach(function(o){\n      o.querySelector('input').checked = false;\n    });\n    opt.querySelector('input').checked = true;\n    var qtyInput = getQtyInput();\n    if (qtyInput) {\n      qtyInput.value = opt.dataset.qty;\n      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n    }\n  }\n\n  options.forEach(function(opt){\n    opt.addEventListener('click', function(evt){\n      evt.preventDefault();\n      selectOption(opt);\n    });\n  });\n\n  if (subscribeInput) {\n    subscribeInput.addEventListener('change', updatePrices);\n  }\n\n  var defaultChecked = options.find(function(o){ return o.querySelector('input').checked; });\n  updatePrices();\n\n  document.addEventListener('DOMContentLoaded', function(){\n    if (defaultChecked) selectOption(defaultChecked);\n  });\n\n  function getSelectedOption(){\n    return options.find(function(o){ return o.querySelector('input').checked; }) || defaultChecked;\n  }\n\n  document.addEventListener('submit', function(evt){\n    var form = evt.target;\n    if (!form || !form.matches || !form.matches('[data-type=\"add-to-cart-form\"]')) return;\n    if (form.closest('.shopify-section') !== root) return;\n\n    evt.preventDefault();\n    evt.stopImmediatePropagation();\n\n    var opt = getSelectedOption();\n    var paid = parseInt(opt.dataset.paid, 10);\n    var free = parseInt(opt.dataset.free, 10);\n    var label = opt.dataset.label;\n    var subscribed = !!(subscribeInput && subscribeInput.checked);\n\n    var idInput = form.querySelector('input[name=\"id\"]');\n    var variantId = idInput ? idInput.value : null;\n    if (!variantId) return;\n\n    var items = [{\n      id: variantId,\n      quantity: paid,\n      properties: subscribed\n        ? { '_glunni_plan': label, '_glunni_subscription': 'Yes - 25% recurring' }\n        : { '_glunni_plan': label }\n    }];\n\n    if (free > 0 && freeVariantId) {\n      items.push({\n        id: freeVariantId,\n        quantity: free,\n        properties: { '_glunni_free': '1', '_glunni_note': 'Free gift item from bundle' }\n      });\n    }\n\n    var submitButton = form.querySelector('[type=\"submit\"]');\n    if (submitButton) submitButton.setAttribute('aria-disabled', 'true');\n\n    var cartEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');\n    var body = { items: items, sections_url: window.location.pathname };\n    if (cartEl && typeof cartEl.getSectionsToRender === 'function') {\n      body.sections = cartEl.getSectionsToRender().map(function(s){ return s.id; });\n    }\n\n    fetch(window.routes.cart_add_url, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n      body: JSON.stringify(body)\n    })\n      .then(function(r){ return r.json(); })\n      .then(function(response){\n        if (submitButton) submitButton.removeAttribute('aria-disabled');\n        if (response.status) {\n          alert(response.description || response.message || 'Could not add to cart.');\n          return;\n        }\n        if (cartEl && typeof cartEl.renderContents === 'function') {\n          cartEl.renderContents(response);\n        } else {\n          win"
          }
        },
