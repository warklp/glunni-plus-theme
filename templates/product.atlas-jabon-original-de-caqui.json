      "type": "a-collapsible-content-r3",
      "blocks": {
        "collapsible_content_list_NtGKhx": {
          "type": "_a-collapsible-content-list-r2",
          "settings": {
            "heading_font_size": 16,
            "heading_font_size_mobile": 16,
            "body_font_size": 16,
            "body_font_size_mobile": 16,
            "index_number_size": 30,
