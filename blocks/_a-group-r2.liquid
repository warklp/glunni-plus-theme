<div
  {% if block.settings.has_background %}
    style="background-color: {{ block.settings.bg_color }}; padding: {{ block.settings.group_padding }}px; border-radius: {{ block.settings.group_border_radius }}px;"
  {% endif %}
  {{ block.shopify_attributes }}
>
{% content_for 'blocks' %}
</div>
{% schema %}
{
  "name": "Group",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "has_background",
      "label": "Show background",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7f7f8",
      "visible_if": "{{ block.settings.has_background }}"
    },
    {
      "type": "range",
      "id": "group_padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.has_background }}"
    },
    {
      "type": "range",
      "id": "group_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.has_background }}"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Product Information"
    }
  ] 
}
{% endschema %} 