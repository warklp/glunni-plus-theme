{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .glunni-checklist-banner-{{ section.id }} {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .glunni-checklist-banner-{{ section.id }} .glunni-cb__inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .glunni-checklist-banner-{{ section.id }}.glunni-cb--image-left .glunni-cb__media {
      order: -1;
    }

    .glunni-checklist-banner-{{ section.id }}.glunni-cb--image-right .glunni-cb__media {
      order: 1;
    }
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--media-radius, 8px);
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__media-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__media-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__heading {
    margin: 0 0 1rem 0;
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__text {
    margin: 0 0 1.75rem 0;
    opacity: 0.85;
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__grid {
    display: grid;
    gap: 0.75rem;
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    background-color: rgba(var(--color-foreground), 0.07);
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__chip-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: rgba(var(--color-foreground), 0.14);
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__chip-icon svg {
    width: 0.85rem;
    height: 0.85rem;
    stroke: rgb(var(--color-foreground));
  }

  .glunni-checklist-banner-{{ section.id }} .glunni-cb__chip-label {
    font-size: 1.4rem;
    line-height: 1.3;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} glunni-checklist-banner-{{ section.id }} glunni-cb--image-{{ section.settings.image_position }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="glunni-cb__inner">
      <div class="glunni-cb__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1500', sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- else -%}
          <div class="glunni-cb__media-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>
      <div class="glunni-cb__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="glunni-cb__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="glunni-cb__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="glunni-cb__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
            {%- for block in section.blocks -%}
              <div class="glunni-cb__chip" {{ block.shopify_attributes }}>
                <span class="glunni-cb__chip-icon">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 8.5L6.2 11.5L13 4.5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="glunni-cb__chip-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Checklist com imagem",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Sinta a diferença todos os dias"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Feito para acompanhar sua rotina com o GLP-1, com resultados que você percebe no dia a dia."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posição da imagem",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "right",
          "label": "Direita"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Colunas do checklist",
      "options": [
        {
          "value": "1",
          "label": "1 coluna"
        },
        {
          "value": "2",
          "label": "2 colunas"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Item do checklist",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto do item",
          "default": "Menos inchaço"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Checklist com imagem",
      "blocks": [
        {
          "type": "checklist_item",
          "settings": {
            "label": "Alívio do inchaço"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "label": "Digestão mais leve"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "label": "Rotina intestinal mais regular"
          }
        },
        {
          "type": "checklist_item",
          "settings": {
            "label": "Resultados que você sente"
          }
        }
      ]
    }
  ]
}
{% endschema %}
