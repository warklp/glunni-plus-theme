{%- comment -%}
  Social fan — a peacock-style fan of portrait photo cards arranged on the rim of a giant
  (mostly off-screen) wheel, with a heading + social links centred above. The wheel auto-
  advances one card every few seconds, so the photos drift across in an arc (like gruns.co).

  Each card is a big square (.social-fan__orbit) centred on the wheel pivot, with the photo
  pinned to its 12-o'clock point; rotating the square moves the photo along the circle.
{%- endcomment -%}
{% render 'a-atlas-fonts-r2', atlas_font: section.settings.atlas_font %}

{%- liquid
  # Spread the photos evenly around the FULL wheel (360°) so the top arc is always
  # populated as it spins — a partial arc would rotate off the top and leave it empty.
  assign count = section.blocks.size
  assign step = 0
  if count > 0
    assign step = 360.0 | divided_by: count
  endif
  assign dir = 1
  if section.settings.rotate_direction == 'right'
    assign dir = -1
  endif
-%}

{%- style -%}
  #social-fan-{{ section.id }} {
    position: relative;
    overflow: hidden;
    height: {{ section.settings.section_height_mobile }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    {% if section.settings.use_gradient_background %}background: {{ section.settings.section_background_gradient }};{% else %}background-color: {{ section.settings.section_background_color }};{% endif %}
  }
  #social-fan-{{ section.id }} .social-fan__content {
    position: absolute;
    left: 50%;
    top: {{ section.settings.content_top }}px;
    transform: translateX(-50%);
    z-index: 20;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 16px;
    pointer-events: none;
  }
  #social-fan-{{ section.id }} .social-fan__heading {
    margin: 0;
    font-family: var(--atlas-font-heading-family, inherit);
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 0.85;
    font-weight: 800;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    max-width: 20ch;
  }
  #social-fan-{{ section.id }} .social-fan__heading strong {
    color: {{ section.settings.highlighted_color }};
    font-weight: inherit;
  }
  #social-fan-{{ section.id }} .social-fan__socials {
    display: flex;
    gap: {{ section.settings.icon_gap }}px;
    margin-top: 20px;
    pointer-events: auto;
  }
  #social-fan-{{ section.id }} .social-fan__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    border-radius: {{ section.settings.icon_radius }}px;
    background: {{ section.settings.icon_bg_color }};
    color: {{ section.settings.icon_color }};
  }
  #social-fan-{{ section.id }} .social-fan__social svg {
    width: 55%;
    height: 55%;
    fill: currentColor;
  }
  #social-fan-{{ section.id }} .social-fan__fan {
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  #social-fan-{{ section.id }} .social-fan__orbit {
    position: absolute;
    left: 50%;
    top: {{ section.settings.pivot_mobile }}%;
    width: min({{ section.settings.wheel_vw_mobile }}vw, 125rem);
    aspect-ratio: 1 / 1;
    transform-origin: center;
    will-change: transform;
  }
  #social-fan-{{ section.id }} .social-fan__media {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
    width: {{ section.settings.card_width_mobile }}px;
    height: {{ section.settings.card_height_mobile }}px;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    background: #e9e4d4;
  }
  #social-fan-{{ section.id }} .social-fan__media img,
  #social-fan-{{ section.id }} .social-fan__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media screen and (min-width: 769px) {
    #social-fan-{{ section.id }} {
      height: {{ section.settings.section_height_desktop }}px;
    }
    #social-fan-{{ section.id }} .social-fan__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
    #social-fan-{{ section.id }} .social-fan__orbit {
      top: {{ section.settings.pivot_desktop }}%;
      width: min({{ section.settings.wheel_vw_desktop }}vw, 125rem);
    }
    #social-fan-{{ section.id }} .social-fan__media {
      width: {{ section.settings.card_width }}px;
      height: {{ section.settings.card_height }}px;
    }
  }
{%- endstyle -%}

<div id="social-fan-{{ section.id }}" class="social-fan atlas-isolation-wrapper">
  <div class="social-fan__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="social-fan__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- assign socials = 'instagram,tiktok,youtube,facebook,x' | split: ',' -%}
    {%- capture socials_markup -%}
      {%- for net in socials -%}
        {%- assign url_key = net | append: '_url' -%}
        {%- assign url = section.settings[url_key] -%}
        {%- if url != blank -%}
          <a class="social-fan__social" href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ net }}">
            {%- case net -%}
              {%- when 'instagram' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.16.56.55.9 1.11 1.16 1.77.25.64.42 1.36.47 2.43.05 1.07.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.16 1.77c-.55.56-1.11.9-1.77 1.16-.64.25-1.36.42-2.43.47-1.07.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.25-.64-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.47-2.43.26-.66.6-1.22 1.16-1.77.55-.56 1.11-.9 1.77-1.16.64-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.98.04-1.5.2-1.86.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.3.88-.34 1.86-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.04.98.2 1.5.34 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.88.3 1.86.34 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.98-.04 1.5-.2 1.86-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.3-.88.34-1.86.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.98-.2-1.5-.34-1.86a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.36-.14-.88-.3-1.86-.34-1.05-.05-1.37-.06-4.04-.06zm0 3.07a5.13 5.13 0 1 1 0 10.26 5.13 5.13 0 0 1 0-10.26zm0 1.8a3.33 3.33 0 1 0 0 6.66 3.33 3.33 0 0 0 0-6.66zm5.34-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/></svg>
              {%- when 'tiktok' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 3c.3 2.1 1.5 3.4 3.5 3.6v2.5c-1.2.1-2.3-.3-3.5-1v5.9c0 4-2.9 6.5-6.3 5.9C6.5 21.2 4.5 18 5.4 14.7c.7-2.7 3.3-4.3 6-3.9v2.7c-.5-.2-1-.2-1.6-.1-1.3.2-2.1 1.3-1.9 2.7.2 1.3 1.4 2.2 2.8 1.9 1.2-.3 1.9-1.3 1.9-2.7V3h2.9z"/></svg>
              {%- when 'youtube' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 12s0-3.2-.4-4.7c-.2-.9-.9-1.5-1.7-1.7C19.4 5.2 12 5.2 12 5.2s-7.4 0-8.9.4c-.8.2-1.5.8-1.7 1.7C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.9.9 1.5 1.7 1.7 1.5.4 8.9.4 8.9.4s7.4 0 8.9-.4c.8-.2 1.5-.8 1.7-1.7.4-1.5.4-4.7.4-4.7zM9.8 15V9l5.2 3-5.2 3z"/></svg>
              {%- when 'facebook' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
              {%- when 'x' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.7 21h-6l-4.7-6.2L5.6 21h-3l7-8L2.6 3h6.1l4.3 5.7L17.5 3zm-1 16h1.7L7.6 4.7H5.8L16.5 19z"/></svg>
            {%- endcase -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign socials_trimmed = socials_markup | strip -%}
    {%- if socials_trimmed != '' -%}
      <div class="social-fan__socials">{{ socials_markup }}</div>
    {%- endif -%}
  </div>

  <div class="social-fan__fan" data-social-fan data-step="{{ step }}" data-dir="{{ dir }}" data-interval="{{ section.settings.auto_rotate_interval }}">
    {%- for block in section.blocks -%}
      {%- assign base = forloop.index0 | times: step -%}
      <div
        class="social-fan__orbit"
        data-base="{{ base }}"
        style="transform: translate(-50%, 0) rotate({{ base }}deg);"
        {{ block.shopify_attributes }}
      >
        <div class="social-fan__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '231, 300, 462, 600', sizes: '231px', alt: block.settings.image.alt }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var fan = document.querySelector('#social-fan-{{ section.id }} [data-social-fan]');
    if (!fan) return;
    var orbits = [].slice.call(fan.querySelectorAll('.social-fan__orbit'));
    if (!orbits.length) return;
    var bases = orbits.map(function (o) { return parseFloat(o.dataset.base) || 0; });
    var step = parseFloat(fan.dataset.step) || 20;
    var dir = parseFloat(fan.dataset.dir) || 1;
    var interval = parseFloat(fan.dataset.interval) || 3;
    // Continuous drift: one card (step°) every `interval` seconds => step/interval deg per second.
    var speed = interval > 0 ? step / interval : 0;
    var spin = 0, last = null, raf = null;
    function apply() {
      for (var i = 0; i < orbits.length; i++) {
        orbits[i].style.transform = 'translate(-50%, 0) rotate(' + (bases[i] + spin) + 'deg)';
      }
    }
    function frame(t) {
      if (last !== null) { spin += dir * speed * (t - last) / 1000; apply(); }
      last = t;
      raf = requestAnimationFrame(frame);
    }
    function start() { if (raf === null) { last = null; raf = requestAnimationFrame(frame); } }
    function stop() { if (raf !== null) { cancelAnimationFrame(raf); raf = null; } }
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    // Only spin while the section is on screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0.05 }).observe(fan);
    } else {
      start();
    }
  })();
</script>

{%- schema -%}
{
  "name": "Social fan",
  "class": "atlas-isolation-wrapper section",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<strong>1 million members.</strong> we've been getting around"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 30, "max": 120, "step": 2, "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 20, "max": 70, "step": 1, "unit": "px",
      "default": 44
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#14261c" },
    { "type": "color", "id": "highlighted_color", "label": "Highlighted (bold) color", "default": "#1a7a3c" },
    {
      "type": "range",
      "id": "content_top",
      "label": "Content top offset",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 56
    },
    { "type": "header", "content": "Social links", "info": "Icons show only for the networks you fill in." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "x_url", "label": "X (Twitter) URL" },
    { "type": "color", "id": "icon_bg_color", "label": "Icon background", "default": "#1a7a3c" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#ffffff" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "icon_radius", "label": "Icon corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "icon_gap", "label": "Gap between icons", "min": 4, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "card_width", "label": "Desktop card width", "min": 120, "max": 360, "step": 4, "unit": "px", "default": 232 },
    { "type": "range", "id": "card_height", "label": "Desktop card height", "min": 160, "max": 520, "step": 4, "unit": "px", "default": 324 },
    { "type": "range", "id": "card_width_mobile", "label": "Mobile card width", "min": 100, "max": 300, "step": 2, "unit": "px", "default": 168 },
    { "type": "range", "id": "card_height_mobile", "label": "Mobile card height", "min": 140, "max": 440, "step": 4, "unit": "px", "default": 236 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "header", "content": "Fan geometry", "info": "Cards spread evenly around the wheel. Add more photos for a tighter fan (≈18–20 fills the arc)." },
    {
      "type": "range",
      "id": "wheel_vw_desktop",
      "label": "Desktop wheel size",
      "info": "Diameter as % of viewport width. Bigger = flatter arc.",
      "min": 100, "max": 400, "step": 4, "unit": "vw",
      "default": 196
    },
    {
      "type": "range",
      "id": "wheel_vw_mobile",
      "label": "Mobile wheel size",
      "min": 200, "max": 700, "step": 5, "unit": "vw",
      "default": 460
    },
    { "type": "range", "id": "pivot_desktop", "label": "Desktop wheel center", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 70 },
    { "type": "range", "id": "pivot_mobile", "label": "Mobile wheel center", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 66 },
    { "type": "header", "content": "Auto-rotate", "info": "Cards drift continuously. Lower = faster." },
    { "type": "range", "id": "auto_rotate_interval", "label": "Seconds per card", "min": 1, "max": 8, "step": 0.5, "unit": "s", "default": 3 },
    {
      "type": "select",
      "id": "rotate_direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "section_height_desktop", "label": "Desktop section height", "min": 500, "max": 1100, "step": 10, "unit": "px", "default": 900 },
    { "type": "range", "id": "section_height_mobile", "label": "Mobile section height", "min": 400, "max": 900, "step": 10, "unit": "px", "default": 640 },
    { "type": "checkbox", "id": "use_gradient_background", "label": "Use gradient background", "default": false },
    {
      "type": "color_background",
      "id": "section_background_gradient",
      "label": "Section background gradient",
      "default": "linear-gradient(180deg, rgba(26, 122, 60, 1) 0%, rgba(246, 196, 69, 1) 100%)",
      "visible_if": "{{ section.settings.use_gradient_background }}"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#faf6e8",
      "visible_if": "{{ section.settings.use_gradient_background == false }}"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Atlas fonts" },
    {
      "type": "select",
      "id": "atlas_font",
      "label": "Font",
      "info": "Applies a curated brand font to Atlas sections. Managed by Atlas.",
      "options": [
        { "value": "", "label": "Default (theme)" },
        { "value": "work_sans", "label": "Work Sans" },
        { "value": "inter", "label": "Inter" },
        { "value": "archivo", "label": "Archivo" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social fan",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{%- endschema -%}
