{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .glunni-testimonials-{{ section.id }} {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__heading {
    text-align: center;
    margin: 0 0 2rem 0;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__row {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__card {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 82%;
    max-width: 360px;
    padding: 1.75rem;
    border-radius: 12px;
    background-color: rgba(var(--color-foreground), 0.05);
  }

  @media screen and (min-width: 750px) {
    .glunni-testimonials-{{ section.id }} .glunni-ts__card {
      width: 340px;
    }
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__avatar {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(var(--color-foreground), 0.14);
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__avatar-initial {
    font-size: 1.3rem;
    font-weight: 600;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__author-info {
    display: flex;
    flex-direction: column;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__author-name {
    font-weight: 600;
    line-height: 1.3;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__author-detail {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.25rem;
    opacity: 0.75;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__author-detail svg {
    width: 1rem;
    height: 1rem;
    stroke: rgb(var(--color-foreground));
    flex-shrink: 0;
  }

  .glunni-testimonials-{{ section.id }} .glunni-ts__quote {
    margin: 0;
    line-height: 1.5;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} glunni-testimonials-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="glunni-ts__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="glunni-ts__row">
        {%- for block in section.blocks -%}
          <div class="glunni-ts__card" {{ block.shopify_attributes }}>
            <div class="glunni-ts__author">
              <span class="glunni-ts__avatar">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', width: 48, height: 48 }}
                {%- else -%}
                  <span class="glunni-ts__avatar-initial">{{ block.settings.author_name | slice: 0, 1 | upcase }}</span>
                {%- endif -%}
              </span>
              <span class="glunni-ts__author-info">
                <span class="glunni-ts__author-name">{{ block.settings.author_name }}</span>
                <span class="glunni-ts__author-detail">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 8.5L6.2 11.5L13 4.5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {{ block.settings.author_detail }}
                </span>
              </span>
            </div>
            {%- if block.settings.quote != blank -%}
              <p class="glunni-ts__quote">{{ block.settings.quote }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Depoimentos",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O que estão dizendo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Foto (opcional)"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nome",
          "default": "Marina S."
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Detalhe",
          "default": "42 • Cliente verificada"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Depoimento",
          "default": "Desde que comecei o tratamento com GLP-1 o inchaço não me deixava em paz. Com o Glunni isso mudou já nas primeiras semanas."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Depoimentos",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Marina S.",
            "author_detail": "42 • Cliente verificada",
            "quote": "Desde que comecei o tratamento com GLP-1 o inchaço não me deixava em paz. Com o Glunni isso mudou já nas primeiras semanas."
          }
        },
        {
