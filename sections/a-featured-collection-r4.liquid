{% render 'a-atlas-fonts-r2', atlas_font: section.settings.atlas_font %}
{{ 'a-component-slider.css' | asset_url | stylesheet_tag }}
{{ 'a-template-collection.css' | asset_url | stylesheet_tag }}
{{ 'a-component-card.css' | asset_url | stylesheet_tag }}
{%- comment -%} Load quick-add assets from the section's own CTA setting. The cards render quick
   view from `section.settings.card_cta_type` (product_card_has_custom_settings is always on now),
   and on the host theme we don't control the global `settings.card_cta_type`, so gating on the
   global left the assets unloaded and the modal undefined. Keep the global as a superset. {%- endcomment -%}
{%- if section.settings.card_cta_type == 'quick_view' or settings.card_cta_type == 'quick_view' -%}
  <link rel="stylesheet" href="{{ 'a-quick-add-r2.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'a-quick-add-r2.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- liquid
  assign global_heading_size = settings.enable_global_heading_font_size
  assign global_body_size = settings.enable_global_body_font_size
  assign global_color = settings.enable_global_color
  # Number of product slides actually rendered (for the fraction pagination total).
  assign slide_count = section.settings.products_to_show
  assign coll_size = section.settings.collection.products.size
  if coll_size < slide_count
    assign slide_count = coll_size
  endif
-%}
{% if request.visual_preview_mode %}
  {% assign section_id_variable = 'id' %}
  {% assign section_id_selector = '' %}
{% else %}
  {% assign section_id_variable = section.id %}
  {% assign section_id_selector = '#section-' | append: section.id %}
{% endif %}
<style>
  {%- if request.visual_preview_mode -%}
    {% comment %} don't want fade-in animation in preview mode because it messes up preview {% endcomment %}
    .animation_section,
    .animation_section > * {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }
  {%- endif -%}

  .atlas-isolation-wrapper #Slider-{{ section_id_variable }}.grid {
    align-items: stretch;
  }
  .atlas-isolation-wrapper #Slider-{{ section_id_variable }} .grid__item {
    display: flex;
    flex-direction: column;
    max-width: unset;
    width: 100%;
  }
  .atlas-isolation-wrapper #Slider-{{ section_id_variable }} .grid__item > div {
    height: 100%;
  }


  .atlas-isolation-wrapper .section__featured_collection {
    padding: 5px 0;
  }

  .atlas-isolation-wrapper .section-{{ section_id_variable }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .atlas-isolation-wrapper .title-wrapper {
    margin-bottom: {{ section.settings.gap_text_and_slider_mobile}}px;
  }
  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .title-wrapper {
    margin-bottom: {{ section.settings.gap_text_and_slider_desktop }}px;
  }
    .atlas-isolation-wrapper .section-{{ section_id_variable }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .atlas-isolation-wrapper #collection__description-{{ section_id_variable }},
  .atlas-isolation-wrapper #collection__description-{{ section_id_variable }} p {
    font-size: {% if global_body_size %}var(--atlas-global-body-text-font-size)!important{% else %}{{ section.settings.desc_font_size }}px!important{% endif %};
    line-height: {% if global_body_size %}var(--atlas-global-body-text-font-size)!important{% else %}{{ section.settings.desc_font_size | plus: 8 }}px!important{% endif %};
    color: {% if global_color %}rgb(var(--atlas-color-base-text)){% else %}{{ section.settings.body_text_color }}{% endif %};
  }
  .atlas-isolation-wrapper #collection__description-{{ section_id_variable }} p strong {
    {%- if section.settings.bolded_body_text_use_gradient -%}
      background: {% if section.settings.bolded_body_text_gradient_color != blank %}{{ section.settings.bolded_body_text_gradient_color }}{% else %}var(--atlas-gradient-base-background-1){% endif %};
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    {% else %}
      color: {{ section.settings.bolded_body_text_color }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .product-grid {
    grid-template-columns: repeat({{ section.settings.grid_desktop_columns }}, 1fr);
    {%- comment -%}
      Horizon's `.grid` sets a 14-column `grid-template-areas` template. The grid spec makes the
      column count the max of the areas template and grid-template-columns, so those 14 tracks
      (and their gaps) survive our column override and leave trailing empty space when the row
      isn't full. Reset the areas template so our column count is authoritative at every breakpoint.
    {%- endcomment -%}
    grid-template-areas: none;
    {% if section.settings.enable_slider %}
      gap: 0;
      display: flex;
      width: fit-content;
      padding: 0;
    {% else %}
      gap: {{ section.settings.grid_desktop_gap }}px;
      display: grid;
    {% endif %}
    margin: 0;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.grid_tablet_columns }}, 1fr);
      {% if section.settings.enable_slider %}
        display: flex;
        width: fit-content;
      {% else %}
        display: grid;
        gap: {{ section.settings.grid_tablet_gap }}px;
      {% endif %}
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      {% if section.settings.enable_slider %}
        display: flex;
        width: fit-content;
      {% else %}
        grid-template-columns: repeat({{ section.settings.grid_mobile_columns }}, 1fr);
        display: grid;
        gap: {{ section.settings.grid_mobile_gap }}px;
      {% endif %}
    }
  }

  {%- comment -%} Card settings are always section-level now — the host theme owns its own global settings. {%- endcomment -%}
    .atlas-isolation-wrapper .card-wrapper {
      --atlas-product-card-padding: {{ section.settings.card_padding  }}px;
        --atlas-product-card-corner-radius: {{ section.settings.card_corner_radius | divided_by: 10.0 }}rem;
        --atlas-product-card-text-alignment: {{ section.settings.card_text_alignment }};
        --atlas-product-card-border-width: {{ section.settings.card_border_thickness | divided_by: 10.0 }}rem;
        --atlas-product-card-border-opacity: {{ section.settings.card_border_opacity | divided_by: 100.0 }};
        --atlas-product-card-shadow-opacity: {{ section.settings.card_shadow_opacity | divided_by: 100.0 }};
        --atlas-product-card-shadow-visible: {% if section.settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --atlas-product-card-shadow-horizontal-offset: {{ section.settings.card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --atlas-product-card-shadow-vertical-offset: {{ section.settings.card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --atlas-product-card-shadow-blur-radius: {{ section.settings.card_shadow_blur | divided_by: 10.0 }}rem;
        --atlas-product-card-title-font-size: {{ section.settings.card_title_font_size }}px;
        --atlas-product-card-title-font-size-mobile: {{ section.settings.card_title_font_size_mobile }}px;
        --atlas-product-card-price-font-size: {{ section.settings.card_price_font_size }}px;
        --atlas-product-card-price-font-size-mobile: {{ section.settings.card_price_font_size_mobile }}px;
        --atlas-product-card-compare-at-price-font-size: {{ section.settings.card_compare_at_price_font_size }}px;
        --atlas-product-card-compare-at-price-font-size-mobile: {{ section.settings.card_compare_at_price_font_size_mobile }}px;
        --atlas-product-card-vendor-font-size: {{ section.settings.card_vendor_font_size }}px;
        --atlas-product-card-vendor-font-size-mobile: {{ section.settings.card_vendor_font_size_mobile }}px;
        --atlas-product-card-stock-indicator-font-size: {{ section.settings.card_stock_indicator_font_size }}px;
        --atlas-product-card-stock-indicator-font-size-mobile: {{ section.settings.card_stock_indicator_font_size_mobile }}px;
        --atlas-product-card-button-text-font-size: {{ section.settings.card_button_text_font_size }}px;
        --atlas-product-card-button-text-font-size-mobile: {{ section.settings.card_button_text_font_size_mobile }}px;
        --atlas-product-card-title-text-color: {{ section.settings.card_title_text_color.red }},{{ section.settings.card_title_text_color.green }},{{ section.settings.card_title_text_color.blue }};
        --atlas-product-card-vendor-text-color: {{ section.settings.card_vendor_text_color.red }},{{ section.settings.card_vendor_text_color.green }},{{ section.settings.card_vendor_text_color.blue }};
        --atlas-product-card-price-text-color: {{ section.settings.card_price_text_color.red }},{{ section.settings.card_price_text_color.green }},{{ section.settings.card_price_text_color.blue }};
        --atlas-product-card-compare-at-price-text-color: {{ section.settings.card_compare_at_price_text_color.red }},{{ section.settings.card_compare_at_price_text_color.green }},{{ section.settings.card_compare_at_price_text_color.blue }};
        --atlas-product-card-compare-at-price-color-opacity: {{ section.settings.card_compare_at_price_color_opacity | divided_by: 100.0 }};
        --atlas-product-card-stock-indicator-text-color: {{ section.settings.card_stock_indicator_text_color.red }},{{ section.settings.card_stock_indicator_text_color.green }},{{ section.settings.card_stock_indicator_text_color.blue }};
        --atlas-product-card-stock-indicator-svg-color-1: {{ section.settings.card_stock_indicator_svg_color_1.red }},{{ section.settings.card_stock_indicator_svg_color_1.green }},{{ section.settings.card_stock_indicator_svg_color_1.blue }};
        --atlas-product-card-stock-indicator-svg-color-2: {{ section.settings.card_stock_indicator_svg_color_2.red }},{{ section.settings.card_stock_indicator_svg_color_2.green }},{{ section.settings.card_stock_indicator_svg_color_2.blue }};
        {% if section.settings.card_background_color_use_gradient %}
          --atlas-product-card-background-color: {{ section.settings.card_background_color_gradient }};
        {% else %}
          --atlas-product-card-background-color: rgba({{ section.settings.card_background_color.red }},{{ section.settings.card_background_color.green }},{{ section.settings.card_background_color.blue }},{{ section.settings.card_background_color_opacity | divided_by: 100.0 }});
        {% endif %}
        --atlas-product-card-border-thickness: {{ section.settings.card_border_thickness }}px;
        --atlas-product-card-border-color: {{ section.settings.card_border_color.red }},{{ section.settings.card_border_color.green }},{{ section.settings.card_border_color.blue }};
        --atlas-product-card-border-radius: {{ section.settings.card_border_radius }}px;
        --atlas-product-card-border-opacity: {{ section.settings.card_border_opacity | divided_by: 100.0 }};
        --atlas-product-card-button-main-color: {{ section.settings.card_button_main_color.red }},{{ section.settings.card_button_main_color.green }},{{ section.settings.card_button_main_color.blue }};
        --atlas-product-card-button-secondary-color: {{ section.settings.card_button_secondary_color.red }},{{ section.settings.card_button_secondary_color.green }},{{ section.settings.card_button_secondary_color.blue }};
        --atlas-product-card-button-tertiary-color: {{ section.settings.card_button_tertiary_color.red }},{{ section.settings.card_button_tertiary_color.green }},{{ section.settings.card_button_tertiary_color.blue }};
    }
  {% if section.settings.card_cta_outside_media %}
    {%- assign btn_align = 'center' -%}
    {%- if section.settings.card_button_text_align == 'left' -%}{%- assign btn_align = 'flex-start' -%}{%- elsif section.settings.card_button_text_align == 'right' -%}{%- assign btn_align = 'flex-end' -%}{%- endif -%}
    {% comment %} The button is styled for overlaying the image via .card__inner rules; below the content it needs its own flow + styling. {% endcomment %}
    #shopify-section-{{ section.id }} .card__content .quick-add {
      position: static;
      transform: none;
      left: auto;
      bottom: auto;
      width: 100%;
      max-width: 100%;
      margin-top: 22px;
    }
    #shopify-section-{{ section.id }} .card__content .quick-add__submit {
      border-radius: {{ section.settings.card_button_border_radius }}px !important;
      justify-content: {{ btn_align }};
      padding: 8px 18px !important;
      min-height: 0;
      font-weight: 700 !important;
    }
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-text {
      font-weight: 700 !important;
    }
    {% unless section.settings.card_button_show_icon %}
      #shopify-section-{{ section.id }} .card__content .quick-add__submit .icon-wrap {
        display: none !important;
      }
    {% endunless %}
  {% endif %}
  {%- comment -%} Slider fraction pagination + prev/next controls (gated). Auto-hidden when Swiper locks (all slides fit). {%- endcomment -%}
  {% if section.settings.enable_slider and section.settings.show_slider_pagination %}
    #shopify-section-{{ section.id }} .featured-collection__slider-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      margin-top: 32px;
    }
    #shopify-section-{{ section.id }} .featured-collection__slider-nav:has(.swiper-button-lock) {
      display: none;
    }
    #shopify-section-{{ section.id }} .fc-slider-btn {
      width: 48px;
      height: 48px;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      border: 1px solid {{ section.settings.bolded_heading_text_color }};
      background: transparent;
      color: {{ section.settings.bolded_heading_text_color }};
      transition: opacity 0.15s ease;
    }
    #shopify-section-{{ section.id }} .fc-slider-btn--next {
      background: {{ section.settings.bolded_heading_text_color }};
      color: #ffffff;
    }
    #shopify-section-{{ section.id }} .fc-slider-btn.swiper-button-disabled {
      opacity: 0.35;
      cursor: default;
    }
    #shopify-section-{{ section.id }} .fc-slider-fraction {
      font-size: 14px;
      font-weight: 600;
      color: {{ section.settings.heading_text_color }};
      min-width: 44px;
      text-align: center;
      /* Neutralize Swiper's default .swiper-pagination absolute/full-width so it sits inline between the arrows. */
      position: static !important;
      width: auto !important;
      bottom: auto !important;
      left: auto !important;
    }
  {% endif %}

  {%- comment -%} Marketing-card internals styling (gated, default off → other instances unchanged).
     Also carries the add-to-cart layout reset (card__content flex + .card-product-variant-selector
     position:static) needed whenever the CTA sits below the media, so emit it for
     card_cta_outside_media too — not only marketing mode. {%- endcomment -%}
  {% if section.settings.card_marketing_mode or section.settings.card_cta_outside_media %}
    {%- comment -%}
      Equal-height cards with the CTA pinned near the bottom regardless of title/inventory
      length. The card, its content and information wrappers become flex columns; the
      product info grows so the CTA + promo sit at the bottom.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .card-wrapper,
    #shopify-section-{{ section.id }} .card {
      height: 100%;
    }
    #shopify-section-{{ section.id }} .card--card {
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .card__content {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
    }
    #shopify-section-{{ section.id }} .card__content > .card__information {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
    }
    #shopify-section-{{ section.id }} .card__content > .card__information > .card-information {
      flex: 1 1 auto;
    }
    {%- comment -%}
      Fully reset the inherited add-to-cart wrapper (base a-component-card.css uses
      position:absolute; left:50%; translateX(-50%)) so it flows in normal document flow,
      full width, above the promo line.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .card__content .card-product-variant-selector {
      position: static !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none !important;
      width: 100% !important;
      max-width: 100% !important;
      margin-top: 16px;
    }
    #shopify-section-{{ section.id }} .card__content .card-product-variant-selector product-form,
    #shopify-section-{{ section.id }} .card__content .card-product-variant-selector form,
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart {
      width: 100% !important;
      max-width: 100% !important;
    }
    {%- comment -%} Button colour/fill treatment is MARKETING-MODE ONLY. For a plain outside-media
       CTA (card_cta_outside_media without marketing mode) this would force the button to
       card_button_main_color + white text, overriding the card's own (template-defined) button
       colour. The layout reset above still applies to both modes, so outside-media content stays
       uncovered while the button keeps its native colour. {%- endcomment -%}
    {% if section.settings.card_marketing_mode %}
    {%- comment -%} Available Add to Cart: full-width burgundy button, white text. {%- endcomment -%}
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart {
      background-color: {{ section.settings.card_button_main_color }} !important;
      color: #ffffff !important;
      border-radius: {{ section.settings.card_button_border_radius }}px !important;
      padding: 12px 20px !important;
      min-height: 0 !important;
      opacity: 1;
    }
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart .quick-add__submit-text,
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart .quick-add__submit-price {
      color: #ffffff !important;
    }
    {%- comment -%} Sold out: same footprint, muted disabled state. {%- endcomment -%}
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart[disabled],
    #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart:disabled {
      background-color: {{ section.settings.card_button_main_color }} !important;
      opacity: 0.4;
      cursor: not-allowed;
    }
    {% endif %}
    #shopify-section-{{ section.id }} .card__marketing-subtitle {
      font-size: 14px;
      color: {{ section.settings.card_marketing_subtitle_color }};
      margin: 0;
    }
    #shopify-section-{{ section.id }} .card__marketing-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .card__marketing-chip {
      border: 1px solid {{ section.settings.card_marketing_chip_color }};
      color: {{ section.settings.card_marketing_chip_color }};
      border-radius: 9999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      line-height: 1;
    }
    #shopify-section-{{ section.id }} .card__marketing-promo {
      font-size: 12px;
      font-weight: 600;
      margin: 10px 0 0;
    }
    {% if section.settings.card_price_in_button %}
      #shopify-section-{{ section.id }} .card__content .quick-add__submit-add-to-cart {
        display: flex !important;
        align-items: center;
        justify-content: center !important;
        flex-wrap: wrap;
        column-gap: 8px;
        row-gap: 2px;
      }
      #shopify-section-{{ section.id }} .quick-add__submit-text {
        white-space: nowrap;
      }
      #shopify-section-{{ section.id }} .quick-add__submit-price {
        font-weight: 700;
        white-space: nowrap;
      }
    {% endif %}
  {% endif %}
</style>


  <div
    id="section-{{ section.id }}"
    class="isolate gradient section__featured_collection"
    style="{% if section.settings.use_gradient_background %}background: {{ section.settings.section_background_gradient }};{% else %}background-color: {{ section.settings.section_background_color }};{% endif %}"
  >
    <div class="collection featured-collection-{{ section_id_variable }} section-{{ section_id_variable }}-padding page-width">
      <div class="collection__title title-wrapper title-wrapper--no-top-margin " style="text-align: {{ section.settings.heading_alignment | default: 'center' }};{% if section.settings.heading_alignment == 'left' %} align-items: flex-start;{% elsif section.settings.heading_alignment == 'right' %} align-items: flex-end;{% endif %}">
        {%- comment -%} Optional eyebrow above the heading (generic; blank → nothing). Uses the bolded-heading (accent) color. {%- endcomment -%}
        {%- if section.settings.eyebrow != blank -%}
          <p style="font-size: 12px; font-weight: 600; letter-spacing: 2px; margin: 0 0 8px; color: {{ section.settings.bolded_heading_text_color }};">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <style>
            .atlas-isolation-wrapper #section-heading-{{ section_id_variable }} {
              margin: 0;
              font-size: {% if global_heading_size %}var(--atlas-font-heading-size)!important{% else %}{{ section.settings.heading_font_size }}px!important{% endif %};
              line-height: {% if global_heading_size %}calc(var(--atlas-font-heading-size) + 10px) !important{% else %}{{ section.settings.heading_font_size | plus: 10 }}px!important{% endif %};
              color: {% if global_color %}rgb(var(--atlas-color-base-heading)){% else %}{{ section.settings.heading_text_color }}{% endif %};
            }
            .atlas-isolation-wrapper #section-heading-{{ section_id_variable }} strong {
              {%- if section.settings.bolded_heading_text_use_gradient -%}
                background: {% if section.settings.bolded_heading_text_gradient_color != blank %}{{ section.settings.bolded_heading_text_gradient_color }}{% else %}var(--atlas-gradient-base-background-1){% endif %};
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
              {% else %}
                color: {{ section.settings.bolded_heading_text_color }};
              {%- endif -%}
            }
            @media (max-width: 768px) {
              .atlas-isolation-wrapper #section-heading-{{ section_id_variable }} {
                font-size: {% if global_heading_size %}var(--atlas-font-heading-mob-size) !important{% else %}{{ section.settings.heading_mob_font_size }}px!important{% endif %};
                line-height: {% if global_heading_size %}calc(var(--atlas-font-heading-mob-size) + 10px) !important{% else %}{{ section.settings.heading_mob_font_size }}px!important{% endif %};
              }
            }
          </style>

          <h2 id="section-heading-{{ section_id_variable }}" class="title">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <style>
            .atlas-isolation-wrapper #collection__description-{{ section_id_variable }} {
              margin-top: {{ section.settings.gap_between_heading_and_description_desktop }}px;
            }
            @media (max-width: 768px) {
              .atlas-isolation-wrapper #collection__description-{{ section_id_variable }} {
                margin-top: {{ section.settings.gap_between_heading_and_description_mobile }}px;
              }
            }
          </style>
          <div
            id="collection__description-{{ section_id_variable }}"
            class="collection__description image-with-text__text rte sw-base-text-color"
          >
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      <div
        {% if section.settings.enable_slider %}
          class="swiper"
        {% endif %}
        id="Slider-{{ section_id_variable }}"
      >
        <ul
          class=" {% if section.settings.enable_slider %} swiper-wrapper{% else %} grid{% endif %} product-grid contains-card contains-card--product"
          role="list"
          aria-label="Slider"
        >
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <li
              id="Slide-{{ section_id_variable }}-{{ forloop.index }}"
              class="grid__item {% if section.settings.enable_slider %} swiper-slide {% endif %}"
              {% if section.settings.enable_slider %}
                style="height: auto;padding: 0;"
              {% endif %}
            >
              {% render 'a-card-product-r4',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                section_id: section_id_variable,
                product_card_has_custom_settings: true
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
      {%- if section.settings.enable_slider and section.settings.show_slider_pagination -%}
        {%- comment -%} Fraction pagination + prev/next (gated). Swiper auto-locks/hides it when all slides fit (e.g. desktop). {%- endcomment -%}
        <div class="featured-collection__slider-nav" id="SliderNav-{{ section_id_variable }}">
          <button type="button" class="fc-slider-btn fc-slider-btn--prev" id="SliderPrev-{{ section_id_variable }}" aria-label="Previous products">
            <svg width="9" height="16" viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7.5 1 1.5 8l6 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="fc-slider-fraction" id="SliderFraction-{{ section_id_variable }}" aria-live="polite"></div>
          <button type="button" class="fc-slider-btn fc-slider-btn--next" id="SliderNext-{{ section_id_variable }}" aria-label="Next products">
            <svg width="9" height="16" viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m1.5 1 6 7-6 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>


<script>
  (function () {
    function makeConfig() {
      return {
        slidesPerView: {{ section.settings.slider_slides_per_view_desktop }},
        spaceBetween: 20,
        {%- if section.settings.enable_slider and section.settings.show_slider_pagination -%}
        watchOverflow: true,
        navigation: {
          prevEl: '#SliderPrev-{{ section_id_variable }}',
          nextEl: '#SliderNext-{{ section_id_variable }}'
        },
        pagination: {
          el: '#SliderFraction-{{ section_id_variable }}',
          type: 'fraction',
          formatFractionTotal: function () { return {{ slide_count }}; }
        },
        {%- endif -%}
        breakpoints: {
          320: {
            slidesPerView: {{ section.settings.slider_slides_per_view_mobile }},
          },
          576: {
            slidesPerView: {{ section.settings.slider_slides_per_view_tablet }},
          },
          1024: {
            slidesPerView: {{ section.settings.slider_slides_per_view_desktop }},
          }
        }
      };
    }
    function initSlider() {
      new Swiper('#Slider-{{ section_id_variable }}', makeConfig());
    }
    document.addEventListener('DOMContentLoaded', initSlider);
    document.addEventListener('shopify:section:load', initSlider);
    document.addEventListener('shopify:section:unload', initSlider);
  })();
</script>

