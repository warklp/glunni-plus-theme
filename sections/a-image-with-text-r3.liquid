      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "body_highlighted_color",
      "label": "Bolded body color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Styling"
