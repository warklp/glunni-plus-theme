{% render 'a-atlas-fonts-r2', atlas_font: section.settings.atlas_font %}
{% if request.visual_preview_mode %}
  {% assign section_id_variable = 'id' %}
  {% assign section_id_selector = '' %}
{% else %}
  {% assign section_id_variable = section.id %}
  {% assign section_id_selector = '#section-' | append: section.id %}
{% endif %}
<style>
  .image-with-text__content--desktop-right > * {
    align-self: flex-end;
    text-align: right;
  }

  .atlas-isolation-wrapper .image-with-text__content--desktop-left > * {
    align-self: flex-start;
    text-align: left;
    /* Override the shared high-specificity ≤768px rules that set `margin: 0 auto`
       on the heading/subtext (which would center them), so left-aligned content
       stays left on tablet/mobile too. */
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .atlas-isolation-wrapper .image-with-text__content--desktop-center > * {
    align-self: center;
    text-align: center;
  }
  {% if section_id_selector != blank %}
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__grid {
      margin-bottom: 0;
      padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right_padding }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_padding }}px !important;
      {% if section.settings.card_use_gradient %}
        background: {{ section.settings.card_gradient }} !important;
      {% else %}
        background: {% if section.settings.card_background_color != blank %}{{ section.settings.card_background_color }}{% else %}transparent{% endif %} !important;
      {% endif %}
      border-radius: {{ section.settings.grid_border_radius }}px;
    }
  {% else %}
    .atlas-isolation-wrapper .image-with-text__grid {
      margin-bottom: 0;
      padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right_padding }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_padding }}px !important;
      {% if section.settings.card_use_gradient %}
        background: {{ section.settings.card_gradient }} !important;
      {% else %}
        background: {% if section.settings.card_background_color != blank %}{{ section.settings.card_background_color }}{% else %}transparent{% endif %} !important;
      {% endif %}
      border-radius: {{ section.settings.grid_border_radius }}px;
    }
  {% endif %}

  .atlas-isolation-wrapper .image-with-text__grid {
    gap: 2rem !important;
    align-items: stretch;
  }

  .atlas-isolation-wrapper .image-with-text .grid__item {
    position: relative;
    flex: 1;
  }

  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .image-with-text__grid--reverse {
      flex-direction: row-reverse;
    }
  }

  .atlas-isolation-wrapper .image-with-text__media {
    min-height: 100%;
    overflow: visible;
    background: transparent;
  }

  .atlas-isolation-wrapper .image-with-text__media--small {
    height: 19.4rem;
  }

  .atlas-isolation-wrapper .image-with-text__media--medium {
    height: 29.6rem;
  }

  .atlas-isolation-wrapper .image-with-text__media--large {
    height: 43.5rem;
  }

  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .image-with-text__media--small {
      height: 31.4rem;
    }

    .atlas-isolation-wrapper .image-with-text__media--medium {
      height: 46rem;
    }

    .atlas-isolation-wrapper .image-with-text__media--large {
      height: 69.5rem;
    }
  }

  .atlas-isolation-wrapper .image-with-text__media--placeholder {
    position: relative;
    overflow: hidden;
  }

  .atlas-isolation-wrapper .image-with-text__media--placeholder:after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(var(--atlas-color-foreground), 0.04);
  }



  .atlas-isolation-wrapper .image-with-text__media--placeholder > svg {
    position: absolute;
    left: 50%;
    max-width: 80rem;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    fill: currentColor;
  }

  .atlas-isolation-wrapper .image-with-text__content {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
    align-self: center;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 990px) {
    .atlas-isolation-wrapper .bg-is-accent-1.text-is-accent-1,
    .atlas-isolation-wrapper .bg-is-accent-2.text-is-accent-2,
    .atlas-isolation-wrapper .bg-is-background-1.text-is-background-1,
    .atlas-isolation-wrapper .bg-is-background-2.text-is-background-2,
    .atlas-isolation-wrapper .bg-is-inverse.text-is-inverse {
      padding-left: 0;
      padding-right: 0;
    }
  }

  .atlas-isolation-wrapper .image-with-text .grid__item::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .atlas-isolation-wrapper .image-with-text:not(.image-with-text--overlap)
    .image-with-text__media-item:after {
    border-radius: var(--atlas-media-radius);
  }

  .atlas-isolation-wrapper .image-with-text:not(.image-with-text--overlap)
    .image-with-text__text-item:after {
    border-radius: var(--atlas-text-boxes-radius);
    box-shadow: var(--atlas-text-boxes-shadow-horizontal-offset)
      var(--atlas-text-boxes-shadow-vertical-offset)
      var(--atlas-text-boxes-shadow-blur-radius)
      rgba(var(--atlas-color-shadow), var(--atlas-text-boxes-shadow-opacity));
  }

  .atlas-isolation-wrapper .image-with-text .image-with-text__media-item > div {
    border-radius: var(--atlas-media-radius);
    overflow: hidden;
  }

  .atlas-isolation-wrapper .image-with-text .global-media-settings {
    overflow: hidden !important;

  }

  .atlas-isolation-wrapper .image-with-text .image-with-text__text-item > div {
    border-radius: var(--atlas-text-boxes-radius);
    overflow: hidden;
    box-shadow: var(--atlas-text-boxes-shadow-horizontal-offset)
      var(--atlas-text-boxes-shadow-vertical-offset)
      var(--atlas-text-boxes-shadow-blur-radius)
      rgba(var(--atlas-color-shadow), var(--atlas-text-boxes-shadow-opacity));
  }

  .atlas-isolation-wrapper .image-with-text:not(.image-with-text--overlap)
    .atlas-isolation-wrapper .image-with-text__media-item
    > div,
  .atlas-isolation-wrapper .image-with-text:not(.image-with-text--overlap)
    .image-with-text__text-item
    > div {
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__media-item:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid__item
      .image-with-text__media,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__media
      img {
      /* border-bottom-right-radius: 0;
      border-bottom-left-radius: 0; */
    }

    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__text-item:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid__item
      .image-with-text__content {
      /* border-top-left-radius: 0;
      border-top-right-radius: 0; */
    }

    .atlas-isolation-wrapper .image-with-text.collapse-borders:not(.image-with-text--overlap)
      .image-with-text__content {
      border-top: 0;
    }
  }

  .atlas-isolation-wrapper .image-with-text__content--mobile-right > h2,
  .atlas-isolation-wrapper .image-with-text__content--mobile-right > div,
  .atlas-isolation-wrapper .image-with-text__content--mobile-right > p,
  .atlas-isolation-wrapper .image-with-text__content--mobile-right > a {
    align-self: flex-end;
    text-align: right;
  }

  .atlas-isolation-wrapper .image-with-text__content--mobile-center > h2,
  .atlas-isolation-wrapper .image-with-text__content--mobile-center > div,
  .atlas-isolation-wrapper .image-with-text__content--mobile-center > p,
  .atlas-isolation-wrapper .image-with-text__content--mobile-center > a {
    align-self: center;
    text-align: center;
  }

  .atlas-isolation-wrapper .image-with-text--overlap .image-with-text__content {
    width: 90%;
    margin: -3rem auto 0;
  }

  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .image-with-text__grid--reverse .image-with-text__content {
      margin-left: auto;
    }

    .atlas-isolation-wrapper .image-with-text__content--bottom {
      justify-content: flex-end;
      align-self: flex-end;
    }

    .atlas-isolation-wrapper .image-with-text__content--top {
      justify-content: flex-start;
      align-self: flex-start;
    }

    .atlas-isolation-wrapper .image-with-text__content--mobile-right > h2,
    .atlas-isolation-wrapper .image-with-text__content--mobile-right > div,
    .atlas-isolation-wrapper .image-with-text__content--mobile-right > p,
    .atlas-isolation-wrapper .image-with-text__content--mobile-right > a  {
      align-self: flex-end;
      text-align: right;
    }

     .atlas-isolation-wrapper .image-with-text__content--mobile-left > h2,
    .atlas-isolation-wrapper .image-with-text__content--mobile-left > div,
    .atlas-isolation-wrapper .image-with-text__content--mobile-left > p,
    .atlas-isolation-wrapper .image-with-text__content--mobile-left > a {
      align-self: flex-start;
      text-align: left;
    }


     .atlas-isolation-wrapper .image-with-text__content--mobile-`center` > h2,
    .atlas-isolation-wrapper .image-with-text__content--mobile-center > div,
    .atlas-isolation-wrapper .image-with-text__content--mobile-center > p,
    .atlas-isolation-wrapper .image-with-text__content--mobile-center > a{
      align-self: center;
      text-align: center;
    }

    .atlas-isolation-wrapper .image-with-text--overlap .image-with-text__text-item {
      display: flex;
      padding: 3rem 0;
    }

    .atlas-isolation-wrapper .image-with-text--overlap .image-with-text__content {
      height: auto;
      width: calc(100% + 4rem);
      min-width: calc(100% + 4rem);
      margin-top: 0;
      margin-left: -4rem;
    }

    .atlas-isolation-wrapper .image-with-text--overlap
      .image-with-text__grid--reverse
      .image-with-text__content {
      margin-left: 0;
      margin-right: -4rem;
    }

    .atlas-isolation-wrapper .image-with-text--overlap
      .image-with-text__grid--reverse
      .image-with-text__text-item {
      justify-content: flex-end;
    }

    .atlas-isolation-wrapper .image-with-text__media-item--top {
      align-self: flex-start;
    }
    .atlas-isolation-wrapper .image-with-text__media-item--middle {
      align-self: center;
    }

    .atlas-isolation-wrapper .image-with-text__media-item--bottom {
      align-self: flex-end;
    }


    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__media-item:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__media,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__media
      img,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__text-item:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__content,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__content:after {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }

    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__text-item:after,
    /* .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__content, */
    .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__content:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__media-item:after,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__media,
    .atlas-isolation-wrapper .image-with-text.collapse-corners:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__media
      img {
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    .atlas-isolation-wrapper .image-with-text.collapse-borders:not(.image-with-text--overlap)
      .grid:not(.image-with-text__grid--reverse)
      .image-with-text__content {
      border-left: 0;
    }

    .atlas-isolation-wrapper .image-with-text.collapse-borders:not(.image-with-text--overlap)
      .image-with-text__grid--reverse
      .image-with-text__content {
      border-right: 0;
    }
  }

  .atlas-isolation-wrapper .image-with-text:not(.collapse-corners, .image-with-text--overlap)
    .image-with-text__media-item {
    z-index: 2;
  }

  .atlas-isolation-wrapper .image-with-text__content {
    border-radius: var(--atlas-text-boxes-radius);
    box-shadow: var(--atlas-text-boxes-shadow-horizontal-offset)
      var(--atlas-text-boxes-shadow-vertical-offset)
      var(--atlas-text-boxes-shadow-blur-radius)
      rgba(var(--atlas-color-shadow), var(--atlas-text-boxes-shadow-opacity));
    word-break: break-word;
  }

  {% if section.settings.card_use_gradient %}
    {% if section_id_selector != blank %}
      .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__grid {
        background: {{ section.settings.card_gradient }} !important;
      }
    {% else %}
      .atlas-isolation-wrapper .image-with-text__grid {
        background: {{ section.settings.card_gradient }} !important;
      }
    {% endif %}
  {% else %}
    {% if section_id_selector != blank %}
      .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__grid {
        background: {% if section.settings.card_background_color != blank %}{{ section.settings.card_background_color }}{% else %}transparent{% endif %} !important;
      }
    {% else %}
      .atlas-isolation-wrapper .image-with-text__grid {
        background: {% if section.settings.card_background_color != blank %}{{ section.settings.card_background_color }}{% else %}transparent{% endif %} !important;
      }
    {% endif %}
  {% endif %}

  @media screen and (min-width: 990px) {
    .atlas-isolation-wrapper .image-with-text__content {
      padding: 6rem 7rem 7rem;
    }
  }

  .atlas-isolation-wrapper .image-with-text__content > :is(h2, div, p, a) + :is(h2, div, p, a),
  {
    margin-top: 2rem;
  }

  .atlas-isolation-wrapper .image-with-text__content > .image-with-text__text:empty ~ a {
    margin-top: 2rem;
  }

  .atlas-isolation-wrapper .image-with-text__content > :first-child:is(.image-with-text__heading),
  .atlas-isolation-wrapper .image-with-text__text--caption + .image-with-text__heading,
  .atlas-isolation-wrapper .image-with-text__text--caption:first-child {
    margin-top: 0;
  }

  .atlas-isolation-wrapper .image-with-text__content :last-child:is(.image-with-text__heading),
  .atlas-isolation-wrapper .image-with-text__text--caption {
    margin-bottom: 0;
  }

  .atlas-isolation-wrapper .image-with-text__content .button + .image-with-text__text {
    margin-top: 2rem;
  }

  .atlas-isolation-wrapper .image-with-text__content .image-with-text__text + .button {
    margin-top: 3rem;
  }

  .atlas-isolation-wrapper .image-with-text__heading {
    margin-bottom: 0;
  }

  .atlas-isolation-wrapper .image-with-text__text p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 749px) {
    .atlas-isolation-wrapper .collapse-padding .image-with-text__grid .image-with-text__content {
      padding-left: 0;
      padding-right: 0;
    }

  /* .image-with-text .global-media-settings {
    border-radius: 0px;
  } */
  }

  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .collapse-padding
      .image-with-text__grid:not(.image-with-text__grid--reverse)
      .image-with-text__content:not(.image-with-text__content--desktop-center) {
      padding-right: 0;
    }

    .atlas-isolation-wrapper .collapse-padding
      .image-with-text__grid--reverse
      .image-with-text__content:not(.image-with-text__content--desktop-center) {
      padding-left: 0;
    }
  }

  /* check for flexbox gap in older Safari versions */
  @supports not (inset: 10px) {
    .atlas-isolation-wrapper .image-with-text__grid {
      margin-left: 0;
    }
  }

  /*
    Multirow
    note: consider removing from this stylesheet if multirow-specific styles increase signficantly
  */
  .atlas-isolation-wrapper .multirow__inner {
    display: flex;
    flex-direction: column;
    row-gap: var(--atlas-grid-mobile-vertical-spacing);
  }

  @media screen and (min-width: 750px) {
    .atlas-isolation-wrapper .multirow__inner {
      row-gap: var(--atlas-grid-desktop-vertical-spacing);
    }
  }
</style>

{%- liquid
  assign global_heading_size = settings.enable_global_heading_font_size
  assign global_body_size = settings.enable_global_body_font_size
  assign global_color = settings.enable_global_color
-%}

<style>
  {%- if request.visual_preview_mode -%}
    {% comment %} don't want fade-in animation in preview mode because it messes up preview {% endcomment %}
    .animation_section,
    .animation_section * {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }
  {%- endif -%}

  .atlas-isolation-wrapper {{ section_id_selector }} .section__image_with_text {
    padding: 5px 0;
    margin: -1px 0;
  }

  #image-with-text-container-{{ section_id_variable }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
  }

  @media screen and (min-width: 750px) {
    #image-with-text-container-{{ section_id_variable }} {
      padding-top: {{ section.settings.padding_top }}px !important;
      padding-bottom: {{ section.settings.padding_bottom }}px !important;
    }
  }

  {% if section_id_selector != blank %}
    .atlas-isolation-wrapper {{ section_id_selector }} .section-{{ section_id_variable }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }

    @media screen and (min-width: 750px) {
      .atlas-isolation-wrapper {{ section_id_selector }} .section-{{ section_id_variable }}-padding {
        padding-top: {{ section.settings.padding_top }}px !important;
        padding-bottom: {{ section.settings.padding_bottom }}px !important;
      }
    }
  {% else %}
    .atlas-isolation-wrapper .section-{{ section_id_variable }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }

    @media screen and (min-width: 750px) {
      .atlas-isolation-wrapper .section-{{ section_id_variable }}-padding {
        padding-top: {{ section.settings.padding_top }}px !important;
        padding-bottom: {{ section.settings.padding_bottom }}px !important;
      }
    }
  {% endif %}

  @media screen and (max-width: 600px) {
    .atlas-isolation-wrapper .image-with-text .image-with-text__content {
      padding: 0 10px !important;
    }
  }

  .atlas-isolation-wrapper #block-description-text-{{ section_id_variable }} p {
    font-size: {% if global_body_size %}var(--atlas-global-body-text-font-size){% else %}{{ section.settings.font_size }}px{% endif %} !important;
    color: {% if global_color %}rgb(var(--atlas-color-base-text)){% else %}{{ section.settings.body_color }}{% endif %};
  }

  .atlas-isolation-wrapper #block-heading-{{ section_id_variable }} {
    font-weight: {{ section.settings.heading_font_weight }} !important;
    font-size: {% if global_heading_size %}var(--atlas-font-heading-size){% else %}{{ section.settings.desktop_font_size }}px{% endif %};
    color: {% if global_color %}rgb(var(--atlas-color-base-heading)){% else %}{{ section.settings.heading_color }}{% endif %};
    --atlas-color-highlighted-color: {{ section.settings.heading_highlighted_color }};
    margin-top: 0;
    margin-bottom: 2rem;
  }
  {%- if section.settings.heading_use_gradient -%}
    .atlas-isolation-wrapper #block-heading-{{ section_id_variable }} strong {
      background: {% if section.settings.heading_gradient_color != blank %}{{ section.settings.heading_gradient_color }}{% else %}var(--atlas-gradient-base-background-1){% endif %};
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  {%- endif -%}

  @media (max-width: 768px) {
    .atlas-isolation-wrapper #block-heading-{{ section_id_variable }} {
      font-size: {% if global_heading_size %}var(--atlas-font-heading-mob-size){% else %}{{ section.settings.mobile_font_size }}px{% endif %};
      margin-bottom: 1rem;
    }
  }

  /* Benefits Section Styling */
  .atlas-isolation-wrapper #benefits-{{ section_id_variable }} {
    margin-top: 4rem;
  }

  .atlas-isolation-wrapper #benefits-{{ section_id_variable }} .image-with-text-benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.benefits_gap | default: 12 }}px;
  }

  .atlas-isolation-wrapper #benefits-{{ section_id_variable }} .image-with-text-benefit-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .atlas-isolation-wrapper #benefits-{{ section_id_variable }} .benefit-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .atlas-isolation-wrapper #benefits-{{ section_id_variable }} .benefit-text {
    font-size: {% if global_body_size %}var(--atlas-global-body-text-font-size){% else %}{{ section.settings.benefits_text_size | default: 14 }}px{% endif %};
    margin: 0;
  }

  {%- comment -%} Two-image collage media (gated, default off). Two squares in the media column; the secondary is staggered down. {%- endcomment -%}
  {%- if section.settings.media_layout == 'two_image' -%}
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage {
      display: flex;
      gap: {{ section.settings.media_gap | default: 24 }}px;
      align-items: flex-start;
      width: 100%;
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item {
      aspect-ratio: 1 / 1;
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(var(--atlas-color-foreground), 0.05);
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item--primary {
      flex: 0 1 {{ section.settings.media_primary_width | default: 50 }}%;
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item--secondary {
      flex: 0 1 {{ 100 | minus: section.settings.media_primary_width }}%;
      margin-top: {{ section.settings.media_secondary_offset | default: 0 }}px;
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item svg {
      width: 40%;
      height: auto;
      display: block;
    }
    @media (max-width: 749px) {
      .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__collage-item--secondary {
        margin-top: {{ section.settings.media_secondary_offset | default: 0 | divided_by: 2 }}px;
      }
    }
  {%- endif -%}

  {%- comment -%} Optional media badge overlay (default off): circular award/sticker badge positioned in a media corner. Scoped to this section; other templates unaffected. {%- endcomment -%}
  {%- if section.settings.show_media_badge -%}
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge {
      position: absolute;
      z-index: 3;
      width: {{ section.settings.media_badge_size | default: 84 }}px;
      height: {{ section.settings.media_badge_size | default: 84 }}px;
      border-radius: 9999px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 8px;
      box-sizing: border-box;
      text-align: center;
      font-size: 10px;
      line-height: 1.1;
      background: {{ section.settings.media_badge_background_color }};
      color: {{ section.settings.media_badge_text_color }};
      overflow: hidden;
    }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge-line1 {
      font-weight: 700;
      letter-spacing: 1px;
    }
    {%- if section.settings.media_badge_line_2_color != blank -%}
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge-line2 {
      color: {{ section.settings.media_badge_line_2_color }};
    }
    {%- endif -%}
    {%- assign badge_offset = section.settings.media_badge_offset | default: 16 -%}
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge--bottom_right { right: {{ badge_offset }}px; bottom: {{ badge_offset }}px; }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge--bottom_left { left: {{ badge_offset }}px; bottom: {{ badge_offset }}px; }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge--top_right { right: {{ badge_offset }}px; top: {{ badge_offset }}px; }
    .atlas-isolation-wrapper {{ section_id_selector }} .image-with-text__media-badge--top_left { left: {{ badge_offset }}px; top: {{ badge_offset }}px; }
  {%- endif -%}
</style>

<div id="section-{{ section_id_variable }}" class="rtl">
  <div
    class="section__image_with_text"
    style="{% if section.settings.use_gradient_background %}background: {{ section.settings.section_background_gradient }};{% else %}background-color: {{ section.settings.section_background_color }};{% endif %}"
  >
    <div
      id="image-with-text-container-{{ section_id_variable }}"
      class="image-with-text image-with-text--no-overlap page-width isolate{% if false and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %} section-{{ section_id_variable }}-padding"
      style="max-width: {{ section.settings.card_max_width }}px !important;width: 100%;"
    >
      {%- comment -%} Gated (default off): below the desktop breakpoint (<=989px), force a media-first
        column so the media sits above the content, scoped to this section. Desktop (>=990px) keeps the
        chosen row layout. This covers BOTH tablet and mobile: with layout=text_first the section otherwise
        reverses the stacked column to content-first (content-top) at <=989, so the max-width:989 range is
        required to keep media-top on tablet AND mobile. {%- endcomment -%}
      {%- if section.settings.stack_on_tablet -%}
        {% style %}
          @media screen and (max-width: 989px) {
            {{ section_id_selector }} .image-with-text__grid {
              flex-direction: column !important;
            }
            {{ section_id_selector }} .image-with-text__grid > * {
              width: 100% !important;
              max-width: 100% !important;
            }
          }
        {% endstyle %}
      {%- endif -%}
      <div
        class="image-with-text__grid grid grid--gapless grid--1-col{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}"
        style="padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right_padding }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_padding }}px; {% if section.settings.card_use_gradient %}background: {{ section.settings.card_gradient }};{% elsif section.settings.card_background_color != blank %}background-color: {{ section.settings.card_background_color }};{% endif %} border-radius: {{ section.settings.grid_border_radius }}px;"
      >
        <div
          class="image-with-text__media-item image-with-text__media-item--middle grid__item"
        >
          {% style %}
            {{ section_id_selector }} .image-with-text__media img {
              border-radius: {{ section.settings.image_radius }}px !important;
            }
          {% endstyle %}
          {%- if section.settings.media_layout == 'two_image' -%}
            {%- comment -%} Two-image collage (gated, default off). Both slots always render (placeholder when an asset is absent) so structural QA holds. {%- endcomment -%}
            <div class="image-with-text__collage">
              <div class="image-with-text__collage-item image-with-text__collage-item--primary">
                {%- if section.settings.image != blank -%}
                  {{ section.settings.image | image_url: width: 800, format: 'webp' | image_tag: loading: 'lazy', alt: section.settings.image.alt | escape }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="image-with-text__collage-item image-with-text__collage-item--secondary">
                {%- if section.settings.secondary_image != blank -%}
                  {{ section.settings.secondary_image | image_url: width: 800, format: 'webp' | image_tag: loading: 'lazy', alt: section.settings.secondary_image.alt | escape }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            <div
              class="image-with-text__media image-with-text__media--{{ section.settings.height }} gradient global-media-settings {% if section.settings.image != blank %}media{% else %}image-with-text__media--placeholder placeholder{% endif %}"
              {% if section.settings.height == 'adapt' and section.settings.image != blank %}
                style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              {%- if section.settings.image != blank -%}
                {% if section.settings.defer_loading_image %}
                  {% assign loading = 'lazy' %}
                {% else %}
                  {% assign loading = 'high' %}
                {% endif %}
                {{ section.settings.image | image_url: width: 1200, format: 'webp' | image_tag: loading: loading }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- comment -%} Optional media badge overlay (default off): a small circular award/sticker badge on the media. Supports a real image, or up to two short text lines. Generic — no brand text baked in. {%- endcomment -%}
          {%- if section.settings.show_media_badge -%}
            <div class="image-with-text__media-badge image-with-text__media-badge--{{ section.settings.media_badge_position | default: 'bottom_right' }}">
              {%- if section.settings.media_badge_image != blank -%}
                <img
                  src="{{ section.settings.media_badge_image | image_url: width: 220 }}"
                  alt="{{ section.settings.media_badge_image.alt | escape }}"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: contain; border-radius: 9999px;"
                >
              {%- elsif section.settings.media_badge_line_1 != blank or section.settings.media_badge_line_2 != blank -%}
                {%- if section.settings.media_badge_line_1 != blank -%}<span class="image-with-text__media-badge-line1">{{ section.settings.media_badge_line_1 }}</span>{%- endif -%}
                {%- if section.settings.media_badge_line_2 != blank -%}<span class="image-with-text__media-badge-line2">{{ section.settings.media_badge_line_2 }}</span>{%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        <div
          class="image-with-text__text-item grid__item"
        >
          <div
            id="ImageWithText--{{ section_id_variable }}"
            class="image-with-text__content image-with-text__content--middle image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container"
          >
            {%- comment -%} Optional eyebrow: compact rating star cluster + tracked label. Both default-off/blank → no wrapper. Generic; stars use eyebrow_rating_color, label uses the section accent (heading highlighted) color. {%- endcomment -%}
            {%- if section.settings.eyebrow != blank or section.settings.eyebrow_rating > 0 -%}
              <div
                class="image-with-text__eyebrow"
                style="margin: 0 0 4px; display: flex; align-items: center; gap: 12px; line-height: 1.4;"
              >
                {%- if section.settings.eyebrow_rating > 0 -%}
                  <span
                    class="image-with-text__eyebrow-rating"
                    aria-label="{{ section.settings.eyebrow_rating }} out of 5 stars"
                    style="color: {{ section.settings.eyebrow_rating_color }}; font-size: 14px; letter-spacing: 1px; white-space: nowrap;"
                  >{% for i in (1..section.settings.eyebrow_rating) %}★{% endfor %}</span>
                {%- endif -%}
                {%- if section.settings.eyebrow != blank -%}
                  <span
                    class="image-with-text__eyebrow-label"
                    style="font-size: 12px; font-weight: 600; letter-spacing: 8px; color: {{ section.settings.heading_highlighted_color }};"
                  >{{ section.settings.eyebrow }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2
                id="block-heading-{{ section_id_variable }}"
                class="title image-with-text__heading {{ section.settings.heading_size }}"
                {{ section.shopify_attributes }}
              >
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div
                id="block-description-text-{{ section_id_variable }}"
                class="image-with-text__text sw-base-text-color rte body"
                style="--atlas-color-highlighted-color: {{ section.settings.body_highlighted_color }}; {% if section.settings.layout == 'image_first' %}margin-bottom: 0;{% endif %}"
                {{ section.shopify_attributes }}
              >
                {{ section.settings.text }}
              </div>
            {%- endif -%}

            {%- if section.settings.benefit_1_text != blank
              or section.settings.benefit_2_text != blank
              or section.settings.benefit_3_text != blank
            -%}
              <div class="image-with-text-benefits-container" id="benefits-{{ section_id_variable }}">
                {% style %}
                  #benefits-{{ section_id_variable }} .benefit-text {
                    color: {% if global_color %}rgb(var(--atlas-color-base-text)){% else %}{{ section.settings.benefits_text_color | default: '#000000' }}{% endif %};
                    --atlas-color-highlighted-color: {{ section.settings.benefits_text_highlighted_color | default: '#000000' }};
                  }
                  #benefits-{{ section_id_variable }} .material-icon svg {
                    width: {{ section.settings.benefits_icon_size | default: 20 }}px !important;
                    height: {{ section.settings.benefits_icon_size | default: 20 }}px !important;
                    fill: {% if section.settings.benefits_icon_color %}{{ section.settings.benefits_icon_color }} !important{% else %}{{ settings.colors_accent_3 }}{% endif %};
                  }
                {% endstyle %}
                <ul class="image-with-text-benefits-list">
                  {%- if section.settings.benefit_1_text != blank -%}
                    <li class="image-with-text-benefit-item">
                      {%- if section.settings.benefit_1_custom_icon -%}
                        <img
                          style="margin-right: 8px; width: {{ section.settings.benefits_icon_size | default: 20 }}px !important; min-width: {{ section.settings.benefits_icon_size | default: 20 }}px !important;"
                          width="{{ section.settings.benefits_icon_size | default: 20 }}"
                          height="{{ section.settings.benefits_icon_size | default: 20 }}"
                          src="{{ section.settings.benefit_1_custom_icon | image_url }}"
                          alt="Benefit 1 icon"
                        >
                      {%- elsif section.settings.benefit_1_icon != blank -%}
                        <span
                          style="display:flex;font-size: {{ section.settings.benefits_icon_size | default: 20 }}px !important; color: {% if section.settings.benefits_icon_color %}{{ section.settings.benefits_icon_color }} !important{% else %}{{ settings.colors_accent_3 }}{% endif %};"
                          class="material-icon material-symbols-outlined notranslate"
                        >
                          {{ section.settings.benefit_1_icon }}
                        </span>
                      {%- endif -%}
                      <div class="benefit-text sw-base-text-color">
                        {{ section.settings.benefit_1_text }}
                      </div>
                    </li>
                  {%- endif -%}

                  {%- if section.settings.benefit_2_text != blank -%}
                    <li class="image-with-text-benefit-item">
                      {%- if section.settings.benefit_2_custom_icon -%}
                        <img
                          style="margin-right: 8px; width: {{ section.settings.benefits_icon_size | default: 20 }}px !important; min-width: {{ section.settings.benefits_icon_size | default: 20 }}px !important;"
                          width="{{ section.settings.benefits_icon_size | default: 20 }}"
                          height="{{ section.settings.benefits_icon_size | default: 20 }}"
                          src="{{ section.settings.benefit_2_custom_icon | image_url }}"
                          alt="Benefit 2 icon"
                        >
                      {%- elsif section.settings.benefit_2_icon != blank -%}
                        <span
                          style="display:flex;font-size: {{ section.settings.benefits_icon_size | default: 20 }}px !important; color: {% if section.settings.benefits_icon_color %}{{ section.settings.benefits_icon_color }} !important{% else %}{{ settings.colors_accent_3 }}{% endif %};"
                          class="material-icon material-symbols-outlined notranslate"
                        >
                          {{ section.settings.benefit_2_icon }}
                        </span>
                      {%- endif -%}
                      <div class="benefit-text sw-base-text-color">
                        {{ section.settings.benefit_2_text }}
                      </div>
                    </li>
                  {%- endif -%}

                  {%- if section.settings.benefit_3_text != blank -%}
                    <li class="image-with-text-benefit-item">
                      {%- if section.settings.benefit_3_custom_icon -%}
                        <img
                          style="margin-right: 8px; width: {{ section.settings.benefits_icon_size | default: 20 }}px !important; min-width: {{ section.settings.benefits_icon_size | default: 20 }}px !important;"
                          width="{{ section.settings.benefits_icon_size | default: 20 }}"
                          height="{{ section.settings.benefits_icon_size | default: 20 }}"
                          src="{{ section.settings.benefit_3_custom_icon | image_url }}"
                          alt="Benefit 3 icon"
                        >
                      {%- elsif section.settings.benefit_3_icon != blank -%}
                        <span
                          style="display:flex;font-size: {{ section.settings.benefits_icon_size | default: 20 }}px !important; color: {% if section.settings.benefits_icon_color %}{{ section.settings.benefits_icon_color }} !important{% else %}{{ settings.colors_accent_3 }}{% endif %};"
                          class="material-icon material-symbols-outlined notranslate"
                        >
                          {{ section.settings.benefit_3_icon }}
                        </span>
                      {%- endif -%}
                      <div class="benefit-text sw-base-text-color">
                        {{ section.settings.benefit_3_text }}
                      </div>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank -%}
              <style>
                {{ section_id_selector }} .button {
                  padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
                  font-size: {{ section.settings.button_label_1_size }}px !important;
                  line-height: {{ section.settings.button_label_1_size | plus: 8 }}px !important;
                  {% if section.settings.button_font_weight != blank %}font-weight: {{ section.settings.button_font_weight }} !important;{% endif %}
                  color: {{ section.settings.button_1_text_color }};
                  background-color: {{ section.settings.button_1_background_color }};
                  border-radius: {{ section.settings.button_1_border_radius }}px !important;
                  max-width: {{ section.settings.button_width_increase_desktop }}%;
                  min-width: fit-content;
                  width: 100%;
                  flex-shrink: 0;
                  margin-top: 4rem;
                }
                @media (max-width: 768px) {
                  {{ section_id_selector }} .button {
                    padding: {{ section.settings.button_padding_vertical_mobile }}px {{ section.settings.button_padding_horizontal_mobile }}px;
                    font-size: {{ section.settings.button_label_1_size_mobile }}px !important;
                    line-height: {{ section.settings.button_label_1_size_mobile | plus: 8 }}px !important;
                    max-width: {{ section.settings.button_width_increase_mobile }}%;
                  }
                }
                {%- comment -%} Gated: when a second CTA exists, lay the two buttons out as a row (hug-content) on desktop and a full-width stack on mobile. Single-button instances never hit this. {%- endcomment -%}
                {%- if section.settings.button_2_text != blank -%}
                  {{ section_id_selector }} .image-with-text__cta-row {
                    display: flex;
                    flex-direction: row;
                    flex-wrap: wrap;
                    align-items: center;
                    gap: 16px;
                    margin-top: 4rem;
                  }
                  {{ section_id_selector }} .image-with-text__cta-row .button {
                    margin-top: 0;
                    width: auto;
                    max-width: none;
                  }
                  {{ section_id_selector }} .image-with-text__cta-row .button--outline {
                    background-color: transparent;
                    border: 1px solid {{ section.settings.button_1_background_color }};
                    color: {{ section.settings.button_1_background_color }};
                  }
                  @media (max-width: 768px) {
                    {{ section_id_selector }} .image-with-text__cta-row {
                      flex-direction: column;
                      align-items: stretch;
                      width: 100%;
                    }
                    {{ section_id_selector }} .image-with-text__cta-row .button {
                      width: 100%;
                    }
                  }
                {%- endif -%}
              </style>
              {%- if section.settings.button_2_text != blank -%}<div class="image-with-text__cta-row">{%- endif -%}
              <a
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="button"
              >
                {{- section.settings.button_text -}}
              </a>
              {%- if section.settings.button_2_text != blank -%}
                <a
                  {% if section.settings.button_2_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_2_link }}"
                  {% endif %}
                  class="button{% if section.settings.button_2_style == 'outline' %} button--outline{% endif %}"
                >
                  {{- section.settings.button_2_text -}}
                </a>
              </div>
              {%- endif -%}
            {%- endif -%}

            {%- comment -%} Optional promo chip below the CTAs. Blank → no chip. Generic. {%- endcomment -%}
            {%- if section.settings.offer_chip_text != blank -%}
              <div
                class="image-with-text__offer-chip"
                style="display: inline-flex; align-items: center; align-self: flex-start; margin-top: 16px; padding: 6px 16px; border-radius: 9999px; font-size: 12px; font-weight: 600; background-color: {{ section.settings.offer_chip_background_color }}; color: {{ section.settings.offer_chip_text_color }};"
              >
                {{ section.settings.offer_chip_text }}
              </div>
            {%- endif -%}

            {%- comment -%} Optional trust row: label + up to 3 production logo pickers. Blank label AND no logos → nothing. When a label is set but no logo assets exist yet, render clearly non-interactive QA placeholders. No hard-coded brand names. {%- endcomment -%}
            {%- assign has_trust_logo = false -%}
            {%- if section.settings.trust_logo_1 != blank or section.settings.trust_logo_2 != blank or section.settings.trust_logo_3 != blank -%}
              {%- assign has_trust_logo = true -%}
            {%- endif -%}
            {%- if section.settings.trust_label != blank or has_trust_logo -%}
              {%- comment -%} Keep the 3 trust logos (real images or placeholders) on one row on mobile. Inline styles above force !important here. {%- endcomment -%}
              {%- style -%}
                @media (max-width: 749px) {
                  {{ section_id_selector }} .image-with-text__trust-logos {
                    flex-wrap: nowrap !important;
                    gap: 12px !important;
                  }
                  {{ section_id_selector }} .image-with-text__trust-logos > img,
                  {{ section_id_selector }} .image-with-text__trust-logos > span {
                    flex: 1 1 0;
                    min-width: 0;
                    width: auto !important;
                  }
                  {{ section_id_selector }} .image-with-text__trust-logos > img {
                    height: auto !important;
                    max-height: {{ section.settings.trust_logo_height | default: 28 }}px;
                    object-fit: contain;
                  }
                }
              {%- endstyle -%}
              <div class="image-with-text__trust" style="margin-top: 24px; display: flex; flex-direction: column; gap: 12px; width: 100%;">
                {%- if section.settings.trust_label != blank -%}
                  <span class="image-with-text__trust-label" style="font-size: 10px; letter-spacing: 1px; font-weight: 600; color: {{ section.settings.body_color }};">{{ section.settings.trust_label }}</span>
                {%- endif -%}
                <div class="image-with-text__trust-logos" style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                  {%- if has_trust_logo -%}
                    {%- for n in (1..3) -%}
                      {%- assign logo_key = 'trust_logo_' | append: n -%}
                      {%- assign logo = section.settings[logo_key] -%}
                      {%- if logo != blank -%}
                        <img src="{{ logo | image_url: width: 320 }}" alt="{{ logo.alt | escape }}" width="160" loading="lazy" style="height: {{ section.settings.trust_logo_height | default: 28 }}px; width: auto; object-fit: contain;">
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%} No logo assets yet → non-interactive QA placeholders (production assets pending). {%- endcomment -%}
                    {%- for n in (1..3) -%}
                      <span aria-hidden="true" style="display: inline-flex; align-items: center; justify-content: center; height: {{ section.settings.trust_logo_height | default: 28 }}px; width: 110px; border: 1px dashed {{ section.settings.body_color }}; border-radius: 4px; opacity: 0.5; font-size: 10px; color: {{ section.settings.body_color }};">Logo</span>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "class": "atlas-isolation-wrapper atlas-gradient section animation_section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "defer_loading_image",
      "label": "Defer loading image",
      "info": "Loads the image only when it's close to appearing on screen. Improves performance when this section is further down the page."
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Media layout",
      "info": "Single = one image (default). Two-image collage = two staggered squares in the media column.",
      "options": [
        { "value": "single", "label": "Single image" },
        { "value": "two_image", "label": "Two-image collage" }
      ],
      "default": "single"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image",
      "info": "Used only in the two-image collage layout.",
      "visible_if": "{{ section.settings.media_layout == 'two_image' }}"
    },
    {
      "type": "range",
      "id": "media_gap",
      "label": "Collage gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.media_layout == 'two_image' }}"
    },
    {
      "type": "range",
      "id": "media_primary_width",
      "label": "Primary image width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.media_layout == 'two_image' }}"
    },
    {
      "type": "range",
      "id": "media_secondary_offset",
      "label": "Secondary image vertical offset",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.media_layout == 'two_image' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional small line above the heading. Leave blank to hide."
    },
    {
      "type": "range",
      "id": "eyebrow_rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Eyebrow rating stars",
      "info": "0 = no stars. Renders a compact star cluster before the eyebrow label.",
      "default": 0
    },
    {
      "type": "color",
      "id": "eyebrow_rating_color",
      "label": "Eyebrow rating star color",
      "default": "#000000"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Lorem ipsum",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Second button label",
      "info": "Optional. Leave blank to hide the second button."
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Second button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Promo & trust (optional)"
    },
    {
      "type": "inline_richtext",
      "id": "offer_chip_text",
      "label": "Promo chip text",
      "info": "Optional pill below the buttons. Leave blank to hide."
    },
    {
      "type": "color",
      "id": "offer_chip_background_color",
      "label": "Promo chip background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "offer_chip_text_color",
      "label": "Promo chip text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "trust_label",
      "label": "Trust row label",
      "info": "Optional (e.g. \"As seen at\"). Blank + no logos = no trust row."
    },
    {
      "type": "image_picker",
      "id": "trust_logo_1",
      "label": "Trust logo 1"
    },
    {
      "type": "image_picker",
      "id": "trust_logo_2",
      "label": "Trust logo 2"
    },
    {
      "type": "image_picker",
      "id": "trust_logo_3",
      "label": "Trust logo 3"
    },
    {
      "type": "range",
      "id": "trust_logo_height",
      "label": "Trust logo height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "show_media_badge",
      "label": "Show media badge",
      "info": "Optional circular award/sticker badge overlaid on the image. Off = no badge (default).",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "media_badge_image",
      "label": "Media badge image",
      "info": "Optional. If set, shows this image; otherwise the two text lines below are used.",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "text",
      "id": "media_badge_line_1",
      "label": "Media badge line 1",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "text",
      "id": "media_badge_line_2",
      "label": "Media badge line 2",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "select",
      "id": "media_badge_position",
      "label": "Media badge position",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_right", "label": "Top right" },
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "bottom_right", "label": "Bottom right" }
      ],
      "default": "bottom_right",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "range",
      "id": "media_badge_size",
      "label": "Media badge size",
      "min": 48,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 84,
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "color",
      "id": "media_badge_background_color",
      "label": "Media badge background",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "color",
      "id": "media_badge_text_color",
      "label": "Media badge text color (line 1)",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "color",
      "id": "media_badge_line_2_color",
      "label": "Media badge text color (line 2)",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "range",
      "id": "media_badge_offset",
      "label": "Media badge edge offset",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.show_media_badge }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Image second"
        }
      ],
      "default": "image_first",
      "label": "Image placement"
    },
    {
      "type": "checkbox",
      "id": "stack_on_tablet",
      "label": "Stack media on top below desktop",
      "info": "Below 990px (tablet and mobile), stack the media above the content (media-first). Desktop keeps the chosen row layout. Off = section default.",
      "default": false
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Image height"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "range",
      "id": "grid_border_radius",
      "label": "Section border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "section_padding_left_padding",
